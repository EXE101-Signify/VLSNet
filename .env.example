# Local Compose only. Configure the same secret in Spring Boot and VSLNet.
# Generate with PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
SIGNIFY_VSL_STREAMING_SECRET=
VSLNET_ALLOWED_ORIGINS=http://localhost:3000
VSLNET_BACKEND_URL=http://host.docker.internal:8080
